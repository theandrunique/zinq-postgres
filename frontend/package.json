{
    "name": "frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^24",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.3.0"
    },
    "dependencies": {
        "@lucide/svelte": "^1.70.0",
        "@tanstack/svelte-query": "^6.4.1",
        "axios": "^1.21.1",
        "bits-ui": "^2.20.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "socket.io-client": "^4.8.4",
        "tailwind-merge": "^3.7.0"
    },
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/components/ui": "./src/lib/components/ui/index.ts",
        "#lib/components/MediaGrid": "./src/lib/components/MediaGrid/index.ts",
        "#lib/utils": "./src/lib/utils/index.ts",
        "#lib/types": "./src/lib/types/index.ts",
        "#lib/api/*": "./src/lib/api/*.ts",
        "#lib/utils/*": "./src/lib/utils/*.ts",
        "#lib/services/*": "./src/lib/services/*.ts",
        "#lib/state/*": "./src/lib/state/*.ts",
        "#features": "./src/features/*",
        "#services": "./src/services/*",
        "#lib/*": "./src/lib/*"
    }
}
