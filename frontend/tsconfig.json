{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": ["$app/types", "node"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$features": ["./src/features"],
      "$features/*": ["./src/features/*"],
      "$services": ["./src/services"],
      "$services/*": ["./src/services/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
